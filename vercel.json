{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "public/data/**"
    }
  },
  "redirects": [
    { "source": "/", "destination": "/Web/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/Data/processed/(.*)", "destination": "/public/data/$1" },
    { "source": "/Data/(.*)", "destination": "/public/data/$1" }
  ]
}